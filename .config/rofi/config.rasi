configuration {
    show-icons:    true;
    display-drun:   "Applications";
    disable-history: false;
    display-filebrowser:    "File Browser";
    drun-display-format:    "{name}";
}

* {
    font:   "Cantarell 12";
    bg-color:   rgba(30, 30, 46, 45%);
    fg-color:   white;
    null-color: rgba(0, 0, 0, 0%);
    background-color:   @null-color;
    foreground:     @fg-color;
}

#window {
    background-color:   @bg-color;
    border:     1px;
    border-radius:      16px;
    padding:    0;
    border-color:   rgba(255, 255, 255, 12%);
    width:      760px;
}

#mainbox {
    background-color:   @null-color;
    padding:    12px;
    border-radius:      10;
}

#textbox {
    text-color: white;
    background-color:   @null-color;
}

#listview {
    border:       0px;
    border-radius:   10;
    spacing:      4px ;
    scrollbar:    false;
    padding:      0px ;
    lines:      6;
}

#element {
    border:  0;
    border-radius:  10px;
    padding: 8px 10px ;
    spacing: 10px;
}

#element.normal.normal {
    background-color: @null-color;
    text-color:       white;
}

#element.selected.normal {
    background-color: rgba(255, 255, 255, 14%);
    text-color:       white;
}

#element.alternate.normal {
    background-color: @null-color;
    text-color:       white;
}

#inputbar {
    background-color:   rgba(255, 255, 255, 8%);
    border-color:   @null-color;
    border:     0;
    border-radius:      12px;
    spacing:    5;
    text-color: white;
    padding:    10px 14px ;
    margin:     0px 0px 10px 0px ;
}

#entry {
    spacing:    0;
    border: 0;
    border-radius:  0;
    background-color:   @null-color;
    text-color: white;
    padding:    0;
    placeholder:    "Search";
}

#prompt {
    spacing:    0;
    text-color: @foreground;
    background-color:   @null-color;
}

#inputbar {
    children:   [ prompt,textbox-prompt-colon,entry];
}

#textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em ;
    text-color: white;
    background-color:   @null-color;
}

element-text, element-icon {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size:   1.6em;
}

#message {
    border:       0px;
    border-color: @null-color;
    border-radius:  10;
    padding:      1px;
    spacing:    100;
}